FROM python:3.12.13-alpine3.24@sha256:6d43704baacd1bfbe7c295d7f13079d5d8104ed33568873133f8fc69980419df

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONPATH=/app \
    HOME=/home/commerce

RUN apk upgrade --no-cache \
    && addgroup --system commerce \
    && adduser --system --ingroup commerce --home /home/commerce commerce

WORKDIR /app
COPY pyproject.toml ./
COPY requirements.production.lock ./
COPY commerce ./commerce
COPY frontend ./frontend
COPY alembic.ini ./
COPY alembic ./alembic
COPY scripts ./scripts
COPY .streamlit ./.streamlit
RUN pip install --no-cache-dir -r requirements.production.lock \
    && pip install --no-cache-dir setuptools==80.9.0 wheel==0.45.1 \
    && pip install --no-cache-dir --no-deps --no-build-isolation . \
    && pip uninstall --yes setuptools wheel \
    && chown -R commerce:commerce /app /home/commerce

USER commerce

CMD ["uvicorn", "commerce.agent_api:app", "--host", "0.0.0.0", "--port", "8000"]
