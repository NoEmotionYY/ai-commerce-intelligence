# Copy to a deployment-managed secret file outside version control. Do not use these placeholders.
COMMERCE_APP_IMAGE=registry.example.com/commerce/copilot@sha256:replace-with-reviewed-image-digest
MYSQL_DATABASE=commerce
MYSQL_ROOT_PASSWORD=
MYSQL_RUNTIME_USER=commerce_app
MYSQL_RUNTIME_PASSWORD=
MYSQL_MIGRATION_USER=commerce_migrate
MYSQL_MIGRATION_PASSWORD=
MYSQL_BACKUP_USER=commerce_backup
MYSQL_BACKUP_PASSWORD=
MYSQL_RESTORE_USER=commerce_restore
MYSQL_RESTORE_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
EXPECTED_SCHEMA_HEAD=0016_agent_workflow

AUTH_SIGNING_KEY=
CREDENTIAL_ACTIVE_KEY_ID=primary
# JSON mapping of key id to one base64-encoded 32-byte AES key.
CREDENTIAL_ENCRYPTION_KEYS=

LLM_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

DOUYIN_WEBHOOK_APPLICATIONS=
TIKTOK_SHOP_WEBHOOK_APPLICATIONS=

PUBLIC_HOSTNAME=commerce.example.com
TLS_CERT_FILE=
TLS_KEY_FILE=
COMMERCE_HTTP_BIND=0.0.0.0
COMMERCE_HTTP_PORT=8080
COMMERCE_HTTPS_BIND=0.0.0.0
COMMERCE_HTTPS_PORT=8443
COMMERCE_PUBLIC_HTTPS_PORT=8443
BACKUP_DIRECTORY=/srv/commerce/backups
