# Local Compose uses explicit demo mode. Production must set APP_ENV=production and
# configure real data sources; it must not use Mock ERP/Crawler URLs.
APP_ENV=demo
LOG_LEVEL=INFO
DATABASE_URL=mysql+pymysql://commerce:commerce@mysql:3306/commerce
ERP_BASE_URL=http://mock-erp:8001
CRAWLER_BASE_URL=http://crawler-service:8002
COMPETITOR_BASE_URL=http://mock-competitor-site:8003
ALLOWED_CRAWLER_HOSTS=mock-competitor-site,localhost,127.0.0.1
AGENT_API_URL=http://agent-api:8000
LLM_PROVIDER=offline
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_TOOL_ROUNDS=12
LLM_MAX_TOOL_CALLS=24
AUTH_SIGNING_KEY=请配置至少32位随机值用于V2身份令牌签名
AUTH_TOKEN_TTL_SECONDS=3600
CREDENTIAL_ENCRYPTION_KEYS=
CREDENTIAL_ACTIVE_KEY_ID=
# JSON: {"app_id":{"app_secret":"...","shop_organizations":{"external_shop_id":"organization-slug"}}}
DOUYIN_WEBHOOK_APPLICATIONS=
TIKTOK_SHOP_API_BASE_URL=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_TOKEN_BASE_URL=https://auth.tiktok-shops.com
TIKTOK_SHOP_MAX_ATTEMPTS=2
TIKTOK_SHOP_SYNC_DEADLINE_SECONDS=20
ERP_SERVICE_TOKEN=请生成至少32位随机值
APPROVER_API_KEY=请生成至少32位随机值
OPERATOR_API_KEY=请生成至少32位随机值
CRAWLER_SERVICE_TOKEN=请生成至少32位随机值
DEMO_OPERATOR_API_KEY=
DEMO_APPROVER_API_KEY=
